---
import { Image, Font } from "astro:assets";
import logo from "../assets/images/branding/logo_kit_learning_trimmed.png";

export interface Props {
  title?: string;
  description?: string;
  lang?: "ru" | "en";
  /** URL of the translated counterpart — enables hreflang tags + the language switch. */
  altUrl?: string;
}

const {
  title = "Школа русского языка в Сингапуре — KIT | Занятия для детей от 10 месяцев",
  description = "KIT — русская школа в Сингапуре. Уроки русского языка для детей от 18 месяцев до старшеклассников, занятия с логопедом-дефектологом.",
  lang = "ru",
  altUrl,
} = Astro.props;

const isEn = lang === "en";

// WhatsApp CTA with a language-appropriate pre-fill.
const waText = isEn
  ? "Hello! I'd like to know more about classes at KIT"
  : "Здравствуйте! Хочу узнать про занятия в KIT";
const WA = `https://wa.me/6580745012?text=${encodeURIComponent(waText)}`;
const PHONE = "+65 3138 6228";

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const altCanonical = altUrl ? new URL(altUrl, Astro.site).href : null;
const ruHref = isEn ? altCanonical : canonical;
const enHref = isEn ? canonical : altCanonical;

// UI chrome strings (nav, footer, buttons) per language.
const s = isEn
  ? {
      skip: "Skip to content",
      navAria: "Main navigation",
      openMenu: "Open menu",
      whatsapp: "Message on WhatsApp",
      whatsappShort: "Chat",
      brandAria: "KIT Learning — home",
      footerContacts: "Contact",
      footerSocial: "Follow us",
      footerTagline: "Russian language school in Singapore.",
      langSwitch: "RU",
      langSwitchAria: "Перейти на русскую версию",
    }
  : {
      skip: "Перейти к содержанию",
      navAria: "Основная навигация",
      openMenu: "Открыть меню",
      whatsapp: "Написать в WhatsApp",
      whatsappShort: "Написать",
      brandAria: "KIT Learning — на главную",
      footerContacts: "Контакты",
      footerSocial: "Мы в соцсетях",
      footerTagline: "Школа русского языка в Сингапуре.",
      langSwitch: "EN",
      langSwitchAria: "Switch to English",
    };

// EducationalOrganization / LocalBusiness structured data for local SEO.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["EducationalOrganization", "LocalBusiness"],
  name: "KIT Learning",
  alternateName: "KIT — Школа русского языка в Сингапуре",
  url: "https://www.kit-learning.com",
  description,
  telephone: "+65 3138 6228",
  email: "kit-enrichment@kit-learning.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: "91 Bencoolen St, #08-05 (Office Tower), Sunshine Plaza",
    addressLocality: "Singapore",
    postalCode: "189652",
    addressCountry: "SG",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 1.29958,
    longitude: 103.85336,
  },
  openingHours: "Mo-Su 09:00-18:00",
  sameAs: [
    "https://www.facebook.com/kitsingapore",
    "https://www.instagram.com/kit_russian_language_singapore",
    "https://t.me/kitbestschoolru",
  ],
};

// Absolute (with leading "/") so they jump to the homepage section from any page,
// including subpages like /neurostart. On the homepage they still scroll in-page.
// Some items open a dropdown (children); the rest are plain links.
const navRu = [
  {
    label: "Программы",
    children: [
      { href: "/#programs", label: "Обзор программ" },
      { href: "/neurostart", label: "НейроСтарт" },
      { href: "/chess", label: "Шахматы" },
      { href: "/ib-russian", label: "Русский на IB" },
      { href: "/igcse-russian", label: "Русский на IGCSE" },
    ],
  },
  {
    label: "Расписание",
    children: [
      { href: "/schedule", label: "Расписание занятий" },
      { href: "/calendar", label: "Календарь 2026–2027" },
    ],
  },
  { href: "/teachers", label: "Преподаватели" },
  { href: "/#reviews", label: "Отзывы" },
  { href: "/#contact", label: "Контакты" },
];

const navEn = [
  {
    label: "Programmes",
    children: [
      { href: "/en/#programs", label: "Overview" },
      { href: "/en/neurostart", label: "NeuroStart" },
      { href: "/en/chess", label: "Chess" },
      { href: "/en/ib-russian", label: "Russian for IB" },
      { href: "/en/igcse-russian", label: "Russian for IGCSE" },
    ],
  },
  {
    label: "Schedule",
    children: [
      { href: "/en/schedule", label: "Class schedule" },
      { href: "/en/calendar", label: "Calendar 2026–2027" },
    ],
  },
  { href: "/en/teachers", label: "Teachers" },
  { href: "/en/#reviews", label: "Reviews" },
  { href: "/en/#contact", label: "Contact" },
];

const nav = isEn ? navEn : navRu;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      altUrl && (
        <>
          <link rel="alternate" hreflang="ru" href={ruHref} />
          <link rel="alternate" hreflang="en" href={enHref} />
          <link rel="alternate" hreflang="x-default" href={ruHref} />
        </>
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={isEn ? "en_SG" : "ru_RU"} />
    <meta property="og:url" content={canonical} />

    <!-- Self-hosted Nunito + metric-matched fallback + preload (CLS fix) -->
    <Font cssVariable="--font-nunito" preload />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />

    <!-- Analytics: lightweight stubs run now so events queue immediately, while
         the heavy GA4 + Meta Pixel libraries load off the critical path
         (first interaction, or browser idle, whichever comes first). -->
    <script is:inline>
      // GA4 stub — gtag() calls queue in dataLayer until gtag.js loads.
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        dataLayer.push(arguments);
      };
      gtag("js", new Date());
      gtag("config", "G-8JVCX7MNCM");

      // Meta Pixel stub — fbq() calls queue until fbevents.js loads.
      !(function (f, b, n) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod
            ? n.callMethod.apply(n, arguments)
            : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = "2.0";
        n.queue = [];
      })(window, document);
      fbq("init", "2125691227649525");
      fbq("track", "PageView");

      // Load the real libraries lazily — flushes the queued events on load.
      (function () {
        var done = false;
        function load() {
          if (done) return;
          done = true;
          [
            "https://www.googletagmanager.com/gtag/js?id=G-8JVCX7MNCM",
            "https://connect.facebook.net/en_US/fbevents.js",
          ].forEach(function (src) {
            var t = document.createElement("script");
            t.async = true;
            t.src = src;
            document.head.appendChild(t);
          });
        }
        var evs = ["scroll", "pointerdown", "keydown", "touchstart"];
        function onInteract() {
          evs.forEach(function (e) {
            removeEventListener(e, onInteract);
          });
          load();
        }
        evs.forEach(function (e) {
          addEventListener(e, onInteract, { once: true, passive: true });
        });
        if ("requestIdleCallback" in window)
          requestIdleCallback(load, { timeout: 4000 });
        else setTimeout(load, 3000);
      })();
    </script>
    <noscript
      ><img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=2125691227649525&ev=PageView&noscript=1"
      /></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">{s.skip}</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href={isEn ? "/en/#top" : "/#top"} class="brand" aria-label={s.brandAria}>
          <Image
            src={logo}
            alt="KIT Learning"
            height={56}
            densities={[2]}
            class="brand-logo"
          />
        </a>

        <nav class="main-nav" aria-label={s.navAria}>
          {nav.map((i) =>
            i.children ? (
              <div class="nav-item has-submenu">
                <button
                  class="nav-trigger"
                  type="button"
                  aria-expanded="false"
                  aria-haspopup="true"
                >
                  {i.label}
                  <svg class="nav-chevron" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="currentColor" d="M7 10l5 5 5-5z" />
                  </svg>
                </button>
                <div class="submenu">
                  {i.children.map((c) => <a href={c.href}>{c.label}</a>)}
                </div>
              </div>
            ) : (
              <a class="nav-item nav-link" href={i.href}>
                {i.label}
              </a>
            ),
          )}
        </nav>

        <div class="header-actions">
          <a class="header-phone" href={`tel:${PHONE.replace(/\s/g, "")}`}>
            {PHONE}
          </a>
          <a
            class="btn btn-wa"
            href={WA}
            target="_blank"
            rel="noopener"
            aria-label={s.whatsapp}
            data-cta="whatsapp-header"
          >
            <svg class="wa-icon" viewBox="0 0 24 24" aria-hidden="true"
              ><path
                fill="currentColor"
                d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.42 5.82c0 4.54-3.7 8.23-8.25 8.23-1.52 0-3.01-.41-4.3-1.18l-.31-.18-3.12.82.83-3.04-.2-.32a8.16 8.16 0 0 1-1.26-4.35c0-4.54 3.7-8.24 8.36-8.24m4.52 11.62c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42-.14 0-.31-.02-.47-.02-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28"
              ></path></svg
            >
            <span>{s.whatsapp}</span>
          </a>
          <a
            class="lang-switch"
            href={altUrl}
            hidden={!altUrl}
            aria-label={s.langSwitchAria}
          >
            {s.langSwitch}
          </a>
        </div>

        <button
          class="nav-toggle"
          aria-label={s.openMenu}
          aria-expanded="false"
        >
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <Image
            src={logo}
            alt="KIT Learning"
            height={40}
            densities={[2]}
            class="footer-logo"
          />
          <p class="footer-legal">
            KIT Learning Pte. Ltd.<br />
            UEN: 202437856W
          </p>
        </div>

        <div>
          <h3>{s.footerContacts}</h3>
          <p>
            91 Bencoolen St, #08-05<br />
            Sunshine Plaza, Singapore 189652
          </p>
          <p>
            <a href={`tel:${PHONE.replace(/\s/g, "")}`}>{PHONE}</a><br />
            <a href="mailto:kit-enrichment@kit-learning.com"
              >kit-enrichment@kit-learning.com</a
            >
          </p>
        </div>

        <div>
          <h3>{s.footerSocial}</h3>
          <ul class="footer-social">
            <li>
              <a href="https://www.instagram.com/kit_russian_language_singapore" target="_blank" rel="noopener">Instagram</a>
            </li>
            <li>
              <a href="https://www.facebook.com/kitsingapore" target="_blank" rel="noopener">Facebook</a>
            </li>
            <li>
              <a href="https://t.me/kitbestschoolru" target="_blank" rel="noopener">Telegram</a>
            </li>
          </ul>
          <a class="btn btn-wa footer-wa" href={WA} target="_blank" rel="noopener" data-cta="whatsapp-footer">
            {s.whatsapp}
          </a>
        </div>
      </div>
      <div class="container footer-bottom">
        <p>© {new Date().getFullYear()} KIT Learning Pte. Ltd. {s.footerTagline}</p>
      </div>
    </footer>

    <!-- Sticky mobile WhatsApp — primary conversion goal, always visible -->
    <a
      class="sticky-wa"
      href={WA}
      target="_blank"
      rel="noopener"
      aria-label={s.whatsapp}
      data-cta="whatsapp-sticky"
    >
      <svg class="wa-icon" viewBox="0 0 24 24" aria-hidden="true"
        ><path
          fill="currentColor"
          d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.42 5.82c0 4.54-3.7 8.23-8.25 8.23-1.52 0-3.01-.41-4.3-1.18l-.31-.18-3.12.82.83-3.04-.2-.32a8.16 8.16 0 0 1-1.26-4.35c0-4.54 3.7-8.24 8.36-8.24m4.52 11.62c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42-.14 0-.31-.02-.47-.02-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28"
        ></path></svg
      >
      <span class="sticky-wa-label">{s.whatsappShort}</span>
    </a>

    <script is:inline>
      // Mobile nav toggle
      const toggle = document.querySelector(".nav-toggle");
      const nav = document.querySelector(".main-nav");
      toggle?.addEventListener("click", () => {
        const open = document.body.classList.toggle("nav-open");
        toggle.setAttribute("aria-expanded", String(open));
      });
      nav?.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => {
          document.body.classList.remove("nav-open");
          toggle?.setAttribute("aria-expanded", "false");
        }),
      );

      // Nav dropdowns: click toggles (mobile + keyboard); hover handles desktop.
      function closeSubmenus(except) {
        document.querySelectorAll(".nav-item.open").forEach((o) => {
          if (o === except) return;
          o.classList.remove("open");
          o.querySelector(".nav-trigger")?.setAttribute("aria-expanded", "false");
        });
      }
      document.querySelectorAll(".nav-trigger").forEach((btn) =>
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          const item = btn.closest(".nav-item");
          const willOpen = !item.classList.contains("open");
          closeSubmenus(item);
          item.classList.toggle("open", willOpen);
          btn.setAttribute("aria-expanded", String(willOpen));
        }),
      );
      document.addEventListener("click", (e) => {
        if (!e.target.closest(".nav-item")) closeSubmenus();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeSubmenus();
      });

      // Cross-page anchor links (e.g. /#teachers from /neurostart): browsers with
      // scroll-behavior:smooth sometimes skip the jump on load. Force it, instantly.
      window.addEventListener("load", () => {
        const id = decodeURIComponent(location.hash.slice(1));
        if (!id) return;
        const el = document.getElementById(id);
        if (!el) return;
        const root = document.documentElement;
        const prev = root.style.scrollBehavior;
        root.style.scrollBehavior = "auto";
        el.scrollIntoView();
        root.style.scrollBehavior = prev;
      });

      // Send a GA4 event whenever a WhatsApp CTA is clicked (the primary conversion).
      // Mark "whatsapp_click" as a Key Event in GA4. cta_location tells you which
      // button/page drove it (e.g. whatsapp-hero, whatsapp-chess, whatsapp-sticky).
      document.querySelectorAll('a[data-cta^="whatsapp"]').forEach((a) =>
        a.addEventListener("click", () => {
          if (typeof window.gtag === "function") {
            window.gtag("event", "whatsapp_click", {
              cta_location: a.getAttribute("data-cta"),
            });
          }
        }),
      );
</script>

    <style is:global>
      :root {
        --brand: #0e7c7b;
        --brand-dark: #0a5a59;
        --brand-soft: #e6f2f1;
        --accent: #ff7a4d;
        --accent-soft: #fff0e8;
        /* Darker orange for text/badges that must pass WCAG AA (4.5:1) */
        --accent-ink: #c0451a;
        --cream: #fffbf5;
        --ink: #22303a;
        --muted: #5c6b74;
        --line: #ece6dd;
        --wa: #25d366;
        --wa-dark: #1da851;
        --radius: 18px;
        --shadow: 0 10px 30px rgba(20, 40, 45, 0.08);
        --shadow-lg: 0 20px 50px rgba(20, 40, 45, 0.12);
        --container: 1160px;
        --font: var(--font-nunito), system-ui, -apple-system, "Segoe UI",
          Roboto, sans-serif;
      }

      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
        scroll-padding-top: 90px;
      }
      body {
        margin: 0;
        font-family: var(--font);
        color: var(--ink);
        background: var(--cream);
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      h1,
      h2,
      h3 {
        line-height: 1.12;
        margin: 0 0 0.5em;
        font-weight: 800;
        letter-spacing: -0.02em;
      }
      h2 {
        font-size: clamp(1.7rem, 3.6vw, 2.5rem);
      }
      h3 {
        font-size: 1.25rem;
      }
      p {
        margin: 0 0 1rem;
      }
      a {
        color: var(--brand-dark);
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      img {
        max-width: 100%;
        height: auto;
        display: block;
      }
      .container {
        width: 100%;
        max-width: var(--container);
        margin: 0 auto;
        padding: 0 clamp(1rem, 4vw, 2rem);
      }
      section {
        padding: clamp(3rem, 7vw, 5.5rem) 0;
      }
      .skip-link {
        position: absolute;
        left: -999px;
        top: 0;
        background: #fff;
        padding: 0.6rem 1rem;
        z-index: 200;
        border-radius: 0 0 8px 0;
      }
      .skip-link:focus {
        left: 0;
      }
      .eyebrow {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--brand-dark);
        background: var(--brand-soft);
        padding: 0.35rem 0.9rem;
        border-radius: 999px;
        margin-bottom: 1rem;
      }
      .lead {
        font-size: 1.15rem;
        color: var(--muted);
        max-width: 42rem;
      }
      .section-head {
        max-width: 46rem;
        margin-bottom: 2.5rem;
      }
      .section-head.center {
        margin-inline: auto;
        text-align: center;
      }

      /* ---- Buttons ---- */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        font-family: inherit;
        font-weight: 800;
        font-size: 1rem;
        line-height: 1;
        padding: 0.85rem 1.4rem;
        border-radius: 999px;
        border: 2px solid transparent;
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease,
          background 0.15s ease;
        text-decoration: none;
      }
      .btn:hover {
        text-decoration: none;
        transform: translateY(-2px);
      }
      .btn-wa {
        background: var(--wa);
        color: #fff;
        box-shadow: 0 8px 20px rgba(37, 211, 102, 0.32);
      }
      .btn-wa:hover {
        background: var(--wa-dark);
      }
      .btn-primary {
        background: var(--accent);
        color: #fff;
        box-shadow: 0 8px 20px rgba(255, 122, 77, 0.32);
      }
      .btn-ghost {
        background: #fff;
        color: var(--brand-dark);
        border-color: var(--line);
      }
      .btn-ghost:hover {
        border-color: var(--brand);
      }
      .wa-icon {
        width: 20px;
        height: 20px;
        flex: none;
      }
      .link-arrow {
        font-weight: 800;
        color: var(--brand);
      }
      .link-arrow:hover {
        color: var(--accent);
      }

      /* ---- Header ---- */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255, 251, 245, 0.9);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
      }
      .header-inner {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        min-height: 72px;
      }
      .brand-logo {
        width: auto;
        height: 56px;
        object-fit: contain;
      }
      .main-nav {
        display: flex;
        gap: 1.4rem;
        margin-left: auto;
        align-items: center;
      }
      .nav-item {
        position: relative;
      }
      .main-nav > .nav-link,
      .nav-trigger {
        color: var(--ink);
        font-weight: 700;
        font-size: 0.98rem;
        font-family: inherit;
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
      }
      .main-nav > .nav-link:hover,
      .nav-trigger:hover {
        color: var(--brand);
        text-decoration: none;
      }
      .nav-chevron {
        width: 0.72em;
        height: 0.72em;
        transition: transform 0.2s;
      }
      .submenu {
        position: absolute;
        top: 100%;
        left: 0;
        min-width: 210px;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 12px;
        box-shadow: var(--shadow-lg);
        padding: 0.4rem;
        margin-top: 0.5rem;
        display: none;
        flex-direction: column;
        z-index: 110;
      }
      .submenu::before {
        /* invisible bridge so hover isn't lost in the gap above the menu */
        content: "";
        position: absolute;
        top: -0.5rem;
        left: 0;
        right: 0;
        height: 0.5rem;
      }
      .submenu a {
        color: var(--ink);
        font-weight: 700;
        font-size: 0.95rem;
        padding: 0.6rem 0.8rem;
        border-radius: 8px;
        white-space: nowrap;
      }
      .submenu a:hover {
        background: var(--brand-soft);
        color: var(--brand-dark);
        text-decoration: none;
      }
      .nav-item.open .submenu {
        display: flex;
      }
      .nav-item.open .nav-chevron {
        transform: rotate(180deg);
      }
      @media (min-width: 901px) {
        .nav-item.has-submenu:hover .submenu,
        .nav-item.has-submenu:focus-within .submenu {
          display: flex;
        }
      }
      .header-actions {
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      .header-phone {
        color: var(--ink);
        font-weight: 800;
        white-space: nowrap;
      }
      .lang-switch {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 38px;
        height: 34px;
        padding: 0 0.5rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        font-weight: 800;
        font-size: 0.85rem;
        color: var(--brand-dark);
        background: #fff;
      }
      .lang-switch:hover {
        border-color: var(--brand);
        text-decoration: none;
      }
      .lang-switch[hidden] {
        display: none;
      }
      .nav-toggle {
        display: none;
        flex-direction: column;
        gap: 5px;
        width: 44px;
        height: 44px;
        border: none;
        background: transparent;
        cursor: pointer;
        margin-left: auto;
      }
      .nav-toggle span {
        height: 3px;
        border-radius: 3px;
        background: var(--ink);
        transition: 0.2s;
      }

      /* ---- Footer ---- */
      .site-footer {
        background: var(--brand-dark);
        color: #dcece9;
        padding: 3.5rem 0 2rem;
        margin-top: 2rem;
      }
      .site-footer h3 {
        color: #fff;
        font-size: 1.05rem;
        margin-bottom: 0.8rem;
      }
      .site-footer a {
        color: #dcece9;
      }
      .site-footer a:hover {
        color: #fff;
      }
      .footer-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr 1fr;
        gap: 2.5rem;
      }
      .footer-logo {
        height: 54px;
        width: auto;
        background: #fff;
        padding: 8px 12px;
        border-radius: 12px;
        margin-bottom: 1rem;
      }
      .footer-legal {
        font-size: 0.92rem;
        opacity: 0.85;
      }
      .footer-social {
        list-style: none;
        padding: 0;
        margin: 0 0 1.2rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }
      .footer-wa {
        margin-top: 0.5rem;
      }
      .footer-bottom {
        margin-top: 2.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.15);
        font-size: 0.88rem;
        opacity: 0.8;
      }
      .footer-bottom p {
        margin: 0;
      }

      /* ---- Sticky WhatsApp ---- */
      .sticky-wa {
        position: fixed;
        right: 18px;
        bottom: 18px;
        z-index: 120;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--wa);
        color: #fff;
        font-weight: 800;
        padding: 0.9rem 1.2rem;
        border-radius: 999px;
        box-shadow: 0 12px 28px rgba(37, 211, 102, 0.45);
        transition: transform 0.15s ease;
      }
      .sticky-wa:hover {
        text-decoration: none;
        transform: scale(1.05);
      }
      .sticky-wa .wa-icon {
        width: 26px;
        height: 26px;
      }

      /* ---- Responsive ---- */
      @media (max-width: 900px) {
        .main-nav {
          position: fixed;
          inset: 72px 0 auto 0;
          flex-direction: column;
          gap: 0;
          align-items: stretch;
          background: var(--cream);
          border-bottom: 1px solid var(--line);
          padding: 0.25rem 0 0.5rem;
          box-shadow: var(--shadow);
          display: none;
          max-height: calc(100vh - 72px);
          overflow-y: auto;
        }
        body.nav-open .main-nav {
          display: flex;
        }
        .main-nav > .nav-link,
        .nav-trigger {
          width: 100%;
          justify-content: space-between;
          padding: 0.85rem clamp(1rem, 4vw, 2rem);
          border-bottom: 1px solid var(--line);
          font-size: 1rem;
        }
        .submenu {
          position: static;
          display: none;
          margin: 0;
          padding: 0;
          min-width: 0;
          border: none;
          border-radius: 0;
          box-shadow: none;
          background: var(--brand-soft);
        }
        .submenu::before {
          display: none;
        }
        .submenu a {
          padding: 0.75rem clamp(1.5rem, 6vw, 2.6rem);
          border-bottom: 1px solid var(--line);
          border-radius: 0;
          white-space: normal;
        }
        .header-actions .header-phone,
        .header-actions .btn span {
          display: none;
        }
        .header-actions .btn-wa {
          padding: 0.7rem;
        }
        .header-actions .btn-wa .wa-icon {
          margin: 0;
        }
        .nav-toggle {
          display: flex;
          order: 3;
        }
        .header-actions {
          margin-left: auto;
          order: 2;
          gap: 0.5rem;
        }
      }
      @media (max-width: 720px) {
        .footer-grid {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
        .sticky-wa-label {
          display: none;
        }
        .sticky-wa {
          padding: 0.9rem;
        }
      }
    </style>
  </body>
</html>
