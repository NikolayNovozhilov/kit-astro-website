---
import Layout from "../layouts/Layout.astro";

const WA = `https://wa.me/6580745012?text=${encodeURIComponent(
  "Здравствуйте! Хочу уточнить даты по календарю KIT на 2026–2027",
)}`;

// Static once-a-year data, transcribed from the KIT Calendar 2026–2027 poster.
// Edit here when the school year changes.
const weekdayTerms = [
  { n: 1, range: "11 августа 2026 — 18 декабря 2026" },
  { n: 2, range: "4 января 2027 — 18 июня 2027" },
];
const weekendTerms = [
  { n: 1, range: "15 августа 2026 — 27 декабря 2026" },
  { n: 2, range: "9 января 2027 — 20 июня 2027" },
];

// Each block: a legend colour + a list of dated entries.
const blocks = [
  {
    color: "#f18f38",
    title: "Государственные праздники",
    note: "Школа закрыта",
    items: [
      { date: "9–10 августа 2026", label: "День нации" },
      { date: "8–9 ноября 2026", label: "Дипавали" },
      { date: "25 декабря 2026", label: "Рождество" },
      { date: "1 января 2027", label: "Новый год" },
      { date: "6 и 8 февраля 2027", label: "Китайский Новый год" },
      { date: "10 марта 2027", label: "" },
      { date: "26 марта 2027", label: "Страстная пятница" },
      { date: "1 мая 2027", label: "День труда" },
      { date: "17 мая 2027", label: "" },
      { date: "20 мая 2027", label: "" },
    ],
  },
  {
    color: "#9fbf3b",
    title: "Каникулы",
    note: "",
    items: [
      { date: "3–7 августа 2026", label: "Перед началом года" },
      { date: "19 декабря 2026 — 3 января 2027", label: "Между семестрами" },
      { date: "Весь июль 2027", label: "Летние каникулы" },
    ],
  },
  {
    color: "#4ec3e0",
    title: "Лагеря (кемпы)",
    note: "",
    items: [
      { date: "28 сентября — 2 октября 2026", label: "" },
      { date: "21–24 и 28–31 декабря 2026", label: "Зимний" },
      { date: "9–12 февраля 2027", label: "" },
      { date: "19–23 и 26–30 апреля 2027", label: "" },
      { date: "17–21 мая 2027", label: "" },
      { date: "21–25 и 28–30 июня 2027", label: "Летний" },
    ],
  },
  {
    color: "#d94f4f",
    title: "Дни без занятий",
    note: "Воркшопы для преподавателей",
    items: [
      { date: "21 сентября 2026", label: "" },
      { date: "23 марта 2027", label: "" },
      { date: "11 июня 2027", label: "" },
    ],
  },
  {
    color: "#a45cc0",
    title: "Встречи с преподавателями",
    note: "Сокращённый день",
    items: [
      { date: "27 ноября 2026", label: "" },
      { date: "13 мая 2027", label: "" },
    ],
  },
  {
    color: "#9e9e9e",
    title: "Сокращённые дни",
    note: "",
    items: [{ date: "5 февраля 2027", label: "" }],
  },
  {
    color: "#ff5fb0",
    title: "Новогодние ёлки",
    note: "",
    items: [{ date: "12–13 декабря 2026", label: "" }],
  },
];
---

<Layout
  title="Учебный календарь 2026–2027 — KIT, школа русского языка в Сингапуре"
  description="Календарь KIT на 2026–2027: даты семестров, государственные праздники, каникулы, лагеря, дни без занятий и новогодние ёлки."
>
  <section class="cal-hero">
    <div class="container">
      <span class="eyebrow">Календарь · 2026–2027</span>
      <h1>Учебный календарь</h1>
      <p class="lead">
        Даты семестров, каникулы, праздники и лагеря на учебный год 2026–2027.
        Расписание занятий по группам — на отдельной странице.
      </p>
      <div class="hero-cta">
        <a class="btn btn-ghost" href="/schedule">Расписание занятий →</a>
        <a class="btn btn-wa" href={WA} target="_blank" rel="noopener" data-cta="whatsapp-calendar">
          Задать вопрос
        </a>
      </div>
    </div>
  </section>

  <section class="cal-terms">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Даты семестров</span>
        <h2>Когда идут занятия</h2>
      </div>
      <div class="cal-term-grid">
        <article class="cal-term-card">
          <h3>Будни</h3>
          <ul>
            {weekdayTerms.map((t) => (
              <li><span class="cal-term-n">Семестр {t.n}</span>{t.range}</li>
            ))}
          </ul>
        </article>
        <article class="cal-term-card">
          <h3>Суббота / воскресенье</h3>
          <ul>
            {weekendTerms.map((t) => (
              <li><span class="cal-term-n">Семестр {t.n}</span>{t.range}</li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="cal-dates">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Ключевые даты</span>
        <h2>Праздники, каникулы и события</h2>
      </div>
      <div class="cal-grid">
        {blocks.map((b) => (
          <article class="cal-card">
            <header class="cal-card-head">
              <span class="cal-dot" style={`background:${b.color}`}></span>
              <div>
                <h3>{b.title}</h3>
                {b.note && <p class="cal-note">{b.note}</p>}
              </div>
            </header>
            <ul class="cal-items">
              {b.items.map((it) => (
                <li>
                  <span class="cal-date">{it.date}</span>
                  {it.label && <span class="cal-label">{it.label}</span>}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <p class="cal-foot">
        Даты могут уточняться. Точную информацию всегда подтвердим в
        <a href={WA} target="_blank" rel="noopener" data-cta="whatsapp-calendar-foot"> WhatsApp</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .cal-hero {
    padding: clamp(2.5rem, 6vw, 4rem) 0 clamp(1.5rem, 4vw, 2.5rem);
    background: linear-gradient(180deg, var(--brand-soft), var(--cream));
  }
  .cal-hero .lead { margin-top: 0.5rem; }
  .hero-cta { margin-top: 1.6rem; display: flex; flex-wrap: wrap; gap: 0.8rem; }

  .cal-terms { padding: clamp(2.5rem, 5vw, 3.5rem) 0 0; }
  .cal-term-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.2rem;
  }
  .cal-term-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow);
  }
  .cal-term-card h3 { margin-bottom: 1rem; color: var(--brand-dark); }
  .cal-term-card ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.9rem; }
  .cal-term-card li { font-weight: 700; }
  .cal-term-n {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand);
    margin-bottom: 0.1rem;
  }

  .cal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.2rem;
  }
  .cal-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.4rem;
    box-shadow: var(--shadow);
  }
  .cal-card-head { display: flex; gap: 0.7rem; align-items: flex-start; margin-bottom: 0.9rem; }
  .cal-card-head h3 { font-size: 1.1rem; margin: 0; }
  .cal-dot { flex: none; width: 16px; height: 16px; border-radius: 5px; margin-top: 3px; }
  .cal-note { color: var(--muted); font-size: 0.85rem; margin: 0.1rem 0 0; }

  .cal-items { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.55rem; }
  .cal-items li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.6rem;
    padding-top: 0.55rem;
    border-top: 1px solid var(--line);
  }
  .cal-items li:first-child { border-top: none; padding-top: 0; }
  .cal-date { font-weight: 700; }
  .cal-label { color: var(--muted); font-size: 0.9rem; }

  .cal-foot { margin-top: 2rem; color: var(--muted); font-size: 0.95rem; }
</style>
