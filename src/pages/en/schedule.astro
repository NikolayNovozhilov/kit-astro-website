---
import Layout from "../../layouts/Layout.astro";

const WA = `https://wa.me/6580745012?text=${encodeURIComponent(
  "Hello! I'd like to sign up for classes at KIT and find a convenient time",
)}`;

// ---- Same Google Sheet source as the Russian /schedule page ----
const SHEET_ID = "1ta5lSAKOVQ4CSLBCGv5ouJPSCtLynaVaDavjmtB1w6E";
const SHEET_CSV = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/export?format=csv&gid=0`;

// Sheet columns D–J are Mon–Sun; render English labels here.
const DAY_KEYS = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"];
const DAY_EN: Record<string, string> = {
  "Пн": "Mon", "Вт": "Tue", "Ср": "Wed", "Чт": "Thu",
  "Пт": "Fri", "Сб": "Sat", "Вс": "Sun",
};

type Program = { title: string; subtitle: string; age: string; days: string[] };

function parseCSV(text: string): string[][] {
  const rows: string[][] = [];
  let row: string[] = [];
  let field = "";
  let inQuotes = false;
  for (let i = 0; i < text.length; i++) {
    const c = text[i];
    if (inQuotes) {
      if (c === '"') {
        if (text[i + 1] === '"') { field += '"'; i++; }
        else inQuotes = false;
      } else field += c;
    } else if (c === '"') inQuotes = true;
    else if (c === ",") { row.push(field); field = ""; }
    else if (c === "\n") { row.push(field); rows.push(row); row = []; field = ""; }
    else if (c !== "\r") field += c;
  }
  if (field.length || row.length) { row.push(field); rows.push(row); }
  return rows;
}

// Collapse the five weekdays into a single "Mon–Fri" chip when they all run.
function formatDays(days: string[]): string[] {
  const weekdays = ["Пн", "Вт", "Ср", "Чт", "Пт"];
  if (weekdays.length === days.length && weekdays.every((d) => days.includes(d)))
    return ["Mon–Fri"];
  return days.map((d) => DAY_EN[d] ?? d);
}

let programs: Program[] = [];
let loadError = false;

try {
  const res = await fetch(SHEET_CSV, { signal: AbortSignal.timeout(8000) });
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  const rows = parseCSV(await res.text());

  const headerIdx = rows.findIndex((r) => (r[0] ?? "").trim() === "Группа");
  const dataRows = headerIdx >= 0 ? rows.slice(headerIdx + 1) : [];

  const byKey = new Map<string, Program>();
  for (const r of dataRows) {
    const name = (r[0] ?? "").trim();
    if (!name) continue;
    const age = (r[1] ?? "").trim();
    // Sheet names are "English / Russian" — use the English part as the title here.
    const [en, ru] = name.split("/").map((s) => s.trim());
    const key = `${name}|${age}`;
    const prog =
      byKey.get(key) ?? { title: en || ru, subtitle: en ? ru : "", age, days: [] };
    for (let i = 0; i < DAY_KEYS.length; i++) {
      const cell = (r[3 + i] ?? "").trim();
      if (cell && !prog.days.includes(DAY_KEYS[i])) prog.days.push(DAY_KEYS[i]);
    }
    byKey.set(key, prog);
  }
  programs = [...byKey.values()].map((p) => ({
    ...p,
    days: DAY_KEYS.filter((d) => p.days.includes(d)),
  }));
} catch (e) {
  loadError = true;
}
---

<Layout
  lang="en"
  altUrl="/schedule"
  title="Classes 7 Days a Week — KIT Russian Language School in Singapore"
  description="KIT in Singapore is open and runs classes seven days a week: Russian language, NeuroStart, settling-in groups, chess, Chinese and more — from toddlers to school-age children."
>
  <section class="sch-hero">
    <div class="container">
      <span class="eyebrow">Classes · 2026–2027</span>
      <h1>Classes seven days a week</h1>
      <p class="lead">
        KIT is already open. We run classes every day of the week — from the
        littlest ones to school-age children. Below are our programmes and the
        days they run. We'll suggest a convenient time and available places on
        WhatsApp.
      </p>

      <div class="hero-cta">
        <a class="btn btn-wa" href={WA} target="_blank" rel="noopener" data-cta="whatsapp-en-schedule">
          Book a class
        </a>
        <a class="btn btn-ghost" href="/en/calendar/">Calendar 2026–2027 →</a>
      </div>
    </div>
  </section>

  <section class="sch-list">
    <div class="container">
      {loadError && (
        <div class="sch-fallback">
          <p>
            We couldn't load the programme list. Message us on WhatsApp — we'll be
            glad to tell you about the classes and find a convenient time.
          </p>
          <a class="btn btn-wa" href={WA} target="_blank" rel="noopener" data-cta="whatsapp-en-schedule-fallback">
            Message us on WhatsApp
          </a>
        </div>
      )}

      {!loadError && (
        <div class="sch-grid">
          {programs.map((p) => (
            <article class="sch-card">
              <header class="sch-card-head">
                <h2>{p.title}</h2>
                {p.subtitle && <p class="sch-sub">{p.subtitle}</p>}
              </header>
              {p.age && <p class="sch-age">{p.age}</p>}
              <div class="sch-days">
                {p.days.length > 0 ? (
                  formatDays(p.days).map((d) => <span class="sch-day">{d}</span>)
                ) : (
                  <span class="sch-day sch-day-soft">On request</span>
                )}
              </div>
            </article>
          ))}
        </div>
      )}

      <p class="sch-note">
        This isn't every detail — we'll confirm exact class times and available
        places on
        <a href={WA} target="_blank" rel="noopener" data-cta="whatsapp-en-schedule-note"> WhatsApp</a>.
        If there's no convenient day or time, message us — we often open new
        groups on request.
      </p>
    </div>
  </section>
</Layout>

<style>
  .sch-hero {
    padding: clamp(2.5rem, 6vw, 4rem) 0 clamp(1.5rem, 4vw, 2.5rem);
    background: linear-gradient(180deg, var(--brand-soft), var(--cream));
  }
  .sch-hero .lead { margin-top: 0.5rem; }
  .hero-cta { margin-top: 1.6rem; display: flex; flex-wrap: wrap; gap: 0.8rem; }

  .sch-list { padding-top: clamp(2rem, 5vw, 3rem); }
  .sch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.2rem;
  }
  .sch-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.4rem;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
  }
  .sch-card-head h2 { font-size: 1.15rem; margin: 0 0 0.15rem; }
  .sch-sub { color: var(--muted); font-size: 0.85rem; margin: 0 0 0.2rem; }
  .sch-age { font-weight: 700; color: var(--brand-dark); margin: 0.3rem 0 0; }

  .sch-days {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 1rem;
  }
  .sch-day {
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--brand-dark);
    background: var(--brand-soft);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
  }
  .sch-day-soft { color: var(--muted); background: var(--line); }

  .sch-note {
    margin-top: 2rem;
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 46rem;
  }
  .sch-fallback {
    background: var(--accent-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.6rem;
    text-align: center;
  }
</style>
