---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import heroImg from "../../assets/images/neurostart/neurostart_class_group.jpg";
import sideImg from "../../assets/images/neurostart/neurostart_sensory_math.jpg";
import ageImg from "../../assets/images/neurostart/neurostart_water_play.jpg";

const WA = `https://wa.me/6580745012?text=${encodeURIComponent(
  "Hello! I'd like to know about the NeuroStart programme at KIT",
)}`;

const pillars = [
  {
    title: "Intellect",
    text: "Speech development, reading and writing, maths, logic and getting to know the world around us.",
  },
  {
    title: "Neuro-approach & body",
    text: "Neuro-gymnastics, finger and breathing exercises, gross and fine motor skills, and sport.",
  },
  {
    title: "Creativity",
    text: "Music lessons and art workshops for aesthetic development.",
  },
  {
    title: "Health",
    text: "Active games and fresh-air walks every day.",
  },
];

const ageGroups = [
  {
    title: "Group 2–4 years",
    text: "Gentle settling in, plus speech, sensory and motor development. We learn to communicate, make friends and explore the world through play and a soft introduction to languages.",
  },
  {
    title: "Group 4–6 years",
    text: "Effective preparation for school, a broader outlook, and deeper development of logic, memory and language skills.",
  },
];

const formats = [
  { title: "Russian", text: "Full immersion in a Russian-speaking environment." },
  { title: "English", text: "Classes and communication in English." },
  {
    title: "Bilingual",
    text: "A soft, natural acquisition of two languages in parallel.",
  },
];
---

<Layout
  lang="en"
  altUrl="/neurostart"
  title="NeuroStart — Early Development for Ages 2+ in Singapore | KIT"
  description="NeuroStart — a comprehensive morning programme for toddlers and preschoolers from age 2 in Singapore: intellect, neuro-gymnastics, creativity and health. Russian, English and bilingual formats."
>
  <!-- ===== Hero ===== -->
  <section class="ns-hero">
    <div class="container ns-hero-inner">
      <div class="ns-hero-copy">
        <span class="eyebrow">New programme · for children 2–6</span>
        <h1>NeuroStart — <span class="hl">all-round development from age 2</span></h1>
        <p class="lead">
          Morning classes for toddlers and preschoolers, where academic
          foundations and a neuro-approach come together with movement, creativity
          and the joy of discovery. Our guiding principle is learning through play.
        </p>
        <div class="hero-cta">
          <a class="btn btn-wa" href={WA} target="_blank" rel="noopener" data-cta="whatsapp-en-neurostart-hero">
            <svg class="wa-icon" viewBox="0 0 24 24" aria-hidden="true"
              ><path
                fill="currentColor"
                d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2"
              ></path></svg
            >
            <span>Sign up for NeuroStart</span>
          </a>
          <a class="btn btn-ghost" href="/en/#contact">Find us</a>
        </div>
        <p class="ns-note">Weekday mornings from 9:00 · small groups</p>
      </div>
      <div class="ns-hero-media">
        <Image
          src={heroImg}
          alt="Toddlers in the NeuroStart programme at KIT"
          width={1000}
          loading="eager"
          fetchpriority="high"
          class="ns-hero-img"
        />
      </div>
    </div>
  </section>

  <!-- ===== What it is ===== -->
  <section class="ns-intro">
    <div class="container section-head center">
      <h2>A space where children develop in balance</h2>
      <p class="lead" style="margin-inline:auto">
        We designed the programme around the age and neurophysiological needs of
        toddlers and preschoolers. The comprehensive method covers every key area
        of a child's development — in one day, without rushing or overload.
      </p>
    </div>
  </section>

  <!-- ===== Age groups ===== -->
  <section class="ns-ages">
    <div class="container ns-ages-inner">
      <div class="ns-ages-media">
        <Image src={ageImg} alt="A sensory activity in the NeuroStart programme" width={560} class="ns-ages-img" />
      </div>
      <div>
        <span class="eyebrow">Two age groups</span>
        <h2>A tailored approach for each age</h2>
        <div class="ns-ages-cards">
          {
            ageGroups.map((g) => (
              <div class="ns-card">
                <h3>{g.title}</h3>
                <p>{g.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Pillars ===== -->
  <section class="ns-pillars">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Method</span>
        <h2>What's in the programme</h2>
      </div>
      <div class="ns-grid">
        {
          pillars.map((p) => (
            <div class="ns-card">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== Language formats ===== -->
  <section class="ns-formats">
    <div class="container ns-formats-inner">
      <div class="ns-formats-media">
        <Image src={sideImg} alt="Children in class at KIT" width={560} class="ns-side-img" />
      </div>
      <div>
        <span class="eyebrow">🌍 Language environment</span>
        <h2>3 formats to choose from</h2>
        <ul class="ns-formats-list">
          {
            formats.map((f) => (
              <li>
                <strong>{f.title}</strong>
                <span>{f.text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ===== Organisation / CTA ===== -->
  <section class="ns-cta">
    <div class="container ns-cta-inner">
      <h2>Practical information</h2>
      <ul class="ns-org">
        <li><strong>When:</strong> weekdays, flexible schedule</li>
        <li><strong>Time:</strong> mornings, from 9:00</li>
        <li><strong>Age:</strong> two groups — 2–4 and 4–6 years</li>
        <li><strong>Groups:</strong> small — maximum attention for every child</li>
      </ul>
      <p class="ns-urgency">
        Places are limited. Secure your child's spot — message us and we'll tell
        you about the schedule and fees, and help you choose the right format.
      </p>
      <a class="btn btn-wa" href={WA} target="_blank" rel="noopener" data-cta="whatsapp-en-neurostart-cta">
        <svg class="wa-icon" viewBox="0 0 24 24" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2"
          ></path></svg
        >
        <span>Sign up for NeuroStart</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .ns-hero {
    background: radial-gradient(
        1200px 500px at 80% -10%,
        var(--accent-soft),
        transparent 60%
      ),
      linear-gradient(180deg, var(--cream), #fff);
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }
  .ns-hero-inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .ns-hero h1 { font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 900; }
  .ns-hero h1 .hl { color: var(--accent-ink); }
  .ns-hero .lead { font-size: 1.25rem; color: var(--ink); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin: 1.6rem 0 1rem; }
  .ns-note { font-size: 0.95rem; color: var(--muted); margin: 0; font-weight: 700; }
  .ns-hero-img { width: 100%; height: auto; border-radius: 24px; box-shadow: var(--shadow-lg); object-fit: cover; aspect-ratio: 4 / 3; }

  .ns-ages-inner { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .ns-ages-img { width: 100%; border-radius: 20px; box-shadow: var(--shadow-lg); object-fit: cover; aspect-ratio: 3 / 4; }
  .ns-ages-cards { display: grid; gap: 1rem; margin-top: 1rem; }

  .ns-pillars { background: linear-gradient(180deg, #fff, var(--cream)); }
  .ns-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.3rem; }
  .ns-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.4rem 1.5rem; box-shadow: var(--shadow); }
  .ns-card h3 { color: var(--brand-dark); }
  .ns-card p { color: var(--muted); margin: 0; font-size: 0.98rem; }

  .ns-formats { background: var(--brand-soft); }
  .ns-formats-inner { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .ns-side-img { width: 100%; border-radius: 20px; box-shadow: var(--shadow-lg); object-fit: cover; aspect-ratio: 1 / 1; }
  .ns-formats-list { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.9rem; }
  .ns-formats-list li { background: #fff; border-radius: var(--radius); padding: 1rem 1.3rem; box-shadow: var(--shadow); }
  .ns-formats-list strong { display: block; color: var(--brand-dark); margin-bottom: 0.15rem; }
  .ns-formats-list span { color: var(--muted); font-size: 0.98rem; }

  .ns-cta-inner { max-width: 640px; margin: 0 auto; text-align: center; }
  .ns-org { list-style: none; padding: 0; margin: 1.5rem auto; display: inline-grid; gap: 0.6rem; text-align: left; }
  .ns-org strong { color: var(--ink); }
  .ns-org li { color: var(--muted); }
  .ns-urgency { color: var(--muted); margin-bottom: 1.5rem; }

  @media (max-width: 900px) {
    .ns-hero-inner, .ns-ages-inner, .ns-formats-inner { grid-template-columns: 1fr; }
    .ns-hero-media { order: -1; }
    .ns-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .ns-grid { grid-template-columns: 1fr; }
  }
</style>
