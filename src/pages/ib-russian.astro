---
import Layout from "../layouts/Layout.astro";

const WA = `https://wa.me/6580745012?text=${encodeURIComponent(
  "Здравствуйте! Хочу узнать про подготовку к IB по русскому языку в KIT",
)}`;

const directions = [
  { name: "IB Russian A: Literature", level: "Standard & Higher Level" },
  { name: "IB Russian A: Language and Literature", level: "Standard & Higher Level" },
  { name: "IB Russian B", level: "Standard & Higher Level" },
  { name: "IB MYP", level: "Подготовка к экзаменам по русскому языку" },
];

const schools = [
  "UWCSEA (United World College of South East Asia)",
  "Tanglin Trust School",
  "North London Collegiate School",
  "Canadian International School",
  "и другие ведущие учебные заведения",
];

const steps = [
  "Проведём объективную диагностику текущего уровня студента.",
  "Подберём оптимальный формат и уровень программы.",
  "Составим индивидуальный долгосрочный план — без стресса и на максимальный балл.",
];
---

<Layout
  title="Подготовка к IB по русскому языку и литературе в Сингапуре | KIT"
  description="Готовим к экзаменам IB по русскому: Russian A Literature, Language & Literature, Russian B (SL/HL) и MYP. Более 10 лет опыта, индивидуальные программы, поступление в ведущие вузы."
>
  <!-- Hero -->
  <section class="exam-hero">
    <div class="container">
      <span class="eyebrow">Международные экзамены · более 10 лет опыта</span>
      <h1>Подготовка к IB по русскому языку и литературе</h1>
      <p class="lead">
        Более 10 лет мы готовим студентов к экзаменам Международного бакалавриата
        (IB) по русскому языку и литературе. Наши специалисты составят
        индивидуальную программу с учётом текущего уровня ребёнка, методично
        закроют пробелы и подготовят к высоким результатам — вплоть до
        поступления в ведущие мировые университеты.
      </p>
      <div class="hero-cta">
        <a class="btn btn-wa" href={WA} target="_blank" rel="noopener" data-cta="whatsapp-ib">
          Записаться на консультацию
        </a>
        <a class="btn btn-ghost" href="/#contact">Как нас найти</a>
      </div>
      <ul class="trust-chips">
        <li>10+ лет опыта</li>
        <li>Индивидуальная программа</li>
        <li>SL &amp; HL</li>
        <li>Поступление в ведущие вузы</li>
      </ul>
    </div>
  </section>

  <!-- Directions -->
  <section class="exam-section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Направления подготовки</span>
        <h2>Какие экзамены мы готовим</h2>
      </div>
      <div class="exam-grid">
        {
          directions.map((d) => (
            <div class="exam-card">
              <h3>{d.name}</h3>
              <p>{d.level}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Schools -->
  <section class="exam-schools">
    <div class="container section-head center">
      <span class="eyebrow">Нам доверяют</span>
      <h2>С какими школами мы работаем</h2>
      <p class="lead" style="margin-inline:auto">
        Нам доверяют семьи из передовых международных и частных школ, включая:
      </p>
      <ul class="school-list">
        {schools.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>

  <!-- When to start -->
  <section class="exam-when">
    <div class="container exam-when-inner">
      <div>
        <span class="eyebrow">Когда начинать</span>
        <h2>Рекомендуем начать за 3 года до выпуска</h2>
        <p class="lead">
          Оптимально обратиться к нам за 3 года до окончания школы — или за год до
          официального старта программы IB. Ранний старт позволяет:
        </p>
      </div>
      <ol class="steps">
        {steps.map((s) => <li>{s}</li>)}
      </ol>
    </div>
  </section>

  <!-- CTA -->
  <section class="exam-cta">
    <div class="container exam-cta-inner">
      <h2>Сохраните русский язык в жизни вашего студента</h2>
      <p>
        Напишите нам — подробно проконсультируем по форматам занятий, уровням и
        графику тестирования, подберём программу под вашего ребёнка.
      </p>
      <a class="btn btn-wa" href={WA} target="_blank" rel="noopener" data-cta="whatsapp-ib-cta">
        Написать в WhatsApp
      </a>
      <p class="cross-link">
        Готовитесь к IGCSE? →
        <a href="/igcse-russian">Подготовка к IGCSE по русскому языку</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .exam-hero {
    background: radial-gradient(
        1200px 500px at 80% -10%,
        var(--brand-soft),
        transparent 60%
      ),
      linear-gradient(180deg, var(--cream), #fff);
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(2.5rem, 5vw, 4rem);
  }
  .exam-hero h1 {
    font-size: clamp(2rem, 5vw, 3.1rem);
    font-weight: 900;
    max-width: 20ch;
  }
  .exam-hero .lead {
    max-width: 52ch;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 1.6rem 0;
  }
  .trust-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0;
    margin: 0;
  }
  .trust-chips li {
    background: #fff;
    border: 1px solid var(--line);
    color: var(--brand-dark);
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
  }

  .exam-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.3rem;
  }
  .exam-card {
    background: #fff;
    border: 1px solid var(--line);
    border-left: 4px solid var(--brand);
    border-radius: var(--radius);
    padding: 1.4rem 1.5rem;
    box-shadow: var(--shadow);
  }
  .exam-card h3 {
    color: var(--brand-dark);
    margin-bottom: 0.3rem;
  }
  .exam-card p {
    color: var(--muted);
    margin: 0;
    font-weight: 700;
  }

  .exam-schools {
    background: var(--brand-soft);
  }
  .school-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem auto 0;
    max-width: 40rem;
    display: grid;
    gap: 0.7rem;
    text-align: left;
  }
  .school-list li {
    background: #fff;
    border-radius: var(--radius);
    padding: 0.9rem 1.3rem;
    box-shadow: var(--shadow);
    font-weight: 700;
  }
  .school-list li::before {
    content: "✓";
    color: var(--brand);
    font-weight: 900;
    margin-right: 0.6rem;
  }

  .exam-when-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .steps {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 1rem;
  }
  .steps li {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1rem 1.3rem;
    box-shadow: var(--shadow);
    color: var(--ink);
  }

  .exam-cta {
    background: var(--brand-dark);
    color: #eaf5f3;
  }
  .exam-cta-inner {
    max-width: 620px;
    margin: 0 auto;
    text-align: center;
  }
  .exam-cta h2 {
    color: #fff;
  }
  .exam-cta .btn {
    margin-top: 0.5rem;
  }
  .cross-link {
    margin-top: 1.6rem;
    font-size: 0.95rem;
    opacity: 0.9;
  }
  .cross-link a {
    color: #fff;
    font-weight: 800;
    text-decoration: underline;
  }

  @media (max-width: 760px) {
    .exam-grid,
    .exam-when-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
