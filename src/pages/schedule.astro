---
import Layout from "../layouts/Layout.astro";

const WA = `https://wa.me/6580745012?text=${encodeURIComponent(
  "Здравствуйте! Хочу записаться на занятия в KIT и узнать удобное время",
)}`;

// ---- Single source of truth: the Google Sheet, read live as CSV ----
// Anyone-with-link (Viewer) sharing is enough for this public export endpoint.
// Runs at build time (and per request in `astro dev`), in Node — no CORS.
const SHEET_ID = "1ta5lSAKOVQ4CSLBCGv5ouJPSCtLynaVaDavjmtB1w6E";
const SHEET_CSV = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/export?format=csv&gid=0`;

const DAYS = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"]; // sheet columns D–J

type Program = { title: string; subtitle: string; age: string; days: string[] };

// Minimal RFC-4180-ish CSV parser (handles quotes, escaped quotes, newlines).
function parseCSV(text: string): string[][] {
  const rows: string[][] = [];
  let row: string[] = [];
  let field = "";
  let inQuotes = false;
  for (let i = 0; i < text.length; i++) {
    const c = text[i];
    if (inQuotes) {
      if (c === '"') {
        if (text[i + 1] === '"') { field += '"'; i++; }
        else inQuotes = false;
      } else field += c;
    } else if (c === '"') inQuotes = true;
    else if (c === ",") { row.push(field); field = ""; }
    else if (c === "\n") { row.push(field); rows.push(row); row = []; field = ""; }
    else if (c !== "\r") field += c;
  }
  if (field.length || row.length) { row.push(field); rows.push(row); }
  return rows;
}

// Collapse a set of weekdays into readable chips (Пн–Пт when it's the full week).
function formatDays(days: string[]): string[] {
  const weekdays = ["Пн", "Вт", "Ср", "Чт", "Пт"];
  if (weekdays.length === days.length && weekdays.every((d) => days.includes(d)))
    return ["Пн–Пт"];
  return days;
}

let programs: Program[] = [];
let loadError = false;

try {
  const res = await fetch(SHEET_CSV, { signal: AbortSignal.timeout(8000) });
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  const rows = parseCSV(await res.text());

  const headerIdx = rows.findIndex((r) => (r[0] ?? "").trim() === "Группа");
  const dataRows = headerIdx >= 0 ? rows.slice(headerIdx + 1) : [];

  // Merge rows that are the same programme + age (e.g. NeuroStart half/full day)
  // and keep only which days each runs — no times, no durations.
  const byKey = new Map<string, Program>();
  for (const r of dataRows) {
    const name = (r[0] ?? "").trim();
    if (!name) continue;
    const age = (r[1] ?? "").trim();
    const [en, ru] = name.split("/").map((s) => s.trim());
    const key = `${name}|${age}`;
    const prog =
      byKey.get(key) ?? { title: ru || en, subtitle: ru ? en : "", age, days: [] };
    for (let i = 0; i < DAYS.length; i++) {
      const cell = (r[3 + i] ?? "").trim(); // any non-empty cell = runs that day
      if (cell && !prog.days.includes(DAYS[i])) prog.days.push(DAYS[i]);
    }
    byKey.set(key, prog);
  }
  // Keep sheet order, but sort each programme's days Mon→Sun.
  programs = [...byKey.values()].map((p) => ({
    ...p,
    days: DAYS.filter((d) => p.days.includes(d)),
  }));
} catch (e) {
  loadError = true;
}
---

<Layout
  title="Занятия 7 дней в неделю — KIT, школа русского языка в Сингапуре"
  description="KIT в Сингапуре открыт и ведёт занятия семь дней в неделю: русский язык, НейроСтарт, адаптационные группы, шахматы, китайский и другое — от малышей до школьников."
>
  <section class="sch-hero">
    <div class="container">
      <span class="eyebrow">Занятия · 2026–2027</span>
      <h1>Занятия семь дней в неделю</h1>
      <p class="lead">
        KIT уже открыт. Мы ведём занятия каждый день недели — от самых маленьких
        до школьников. Ниже — наши программы и дни, когда они проходят. Удобное
        время и свободные места подскажем в WhatsApp.
      </p>

      <div class="hero-cta">
        <a class="btn btn-wa" href={WA} target="_blank" rel="noopener" data-cta="whatsapp-schedule">
          Записаться на занятия
        </a>
        <a class="btn btn-ghost" href="/calendar">Календарь 2026–2027 →</a>
      </div>
    </div>
  </section>

  <section class="sch-list">
    <div class="container">
      {loadError && (
        <div class="sch-fallback">
          <p>
            Не удалось загрузить список программ. Напишите нам в WhatsApp — с
            радостью расскажем про занятия и подберём удобное время.
          </p>
          <a class="btn btn-wa" href={WA} target="_blank" rel="noopener" data-cta="whatsapp-schedule-fallback">
            Написать в WhatsApp
          </a>
        </div>
      )}

      {!loadError && (
        <div class="sch-grid">
          {programs.map((p) => (
            <article class="sch-card">
              <header class="sch-card-head">
                <h2>{p.title}</h2>
                {p.subtitle && <p class="sch-sub">{p.subtitle}</p>}
              </header>
              {p.age && <p class="sch-age">{p.age}</p>}
              <div class="sch-days">
                {p.days.length > 0 ? (
                  formatDays(p.days).map((d) => <span class="sch-day">{d}</span>)
                ) : (
                  <span class="sch-day sch-day-soft">По запросу</span>
                )}
              </div>
            </article>
          ))}
        </div>
      )}

      <p class="sch-note">
        Это не все детали — точное время занятий и наличие мест подскажем в
        <a href={WA} target="_blank" rel="noopener" data-cta="whatsapp-schedule-note"> WhatsApp</a>.
        Если удобного дня или времени нет — напишите нам, часто открываем новые
        группы под запрос.
      </p>
    </div>
  </section>
</Layout>

<style>
  .sch-hero {
    padding: clamp(2.5rem, 6vw, 4rem) 0 clamp(1.5rem, 4vw, 2.5rem);
    background: linear-gradient(180deg, var(--brand-soft), var(--cream));
  }
  .sch-hero .lead { margin-top: 0.5rem; }

  .hero-cta { margin-top: 1.6rem; display: flex; flex-wrap: wrap; gap: 0.8rem; }

  .sch-list { padding-top: clamp(2rem, 5vw, 3rem); }
  .sch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.2rem;
  }
  .sch-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.4rem;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
  }
  .sch-card-head h2 { font-size: 1.15rem; margin: 0 0 0.15rem; }
  .sch-sub { color: var(--muted); font-size: 0.85rem; margin: 0 0 0.2rem; }
  .sch-age {
    font-weight: 700;
    color: var(--brand-dark);
    margin: 0.3rem 0 0;
  }

  .sch-days {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 1rem;
  }
  .sch-day {
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--brand-dark);
    background: var(--brand-soft);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
  }
  .sch-day-soft {
    color: var(--muted);
    background: var(--line);
  }

  .sch-note {
    margin-top: 2rem;
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 46rem;
  }
  .sch-fallback {
    background: var(--accent-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.6rem;
    text-align: center;
  }
</style>
