---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import olga from "../assets/images/teachers/teacher_olga_belskaya.jpg";
import iana from "../assets/images/teachers/teacher_yana_belskaya.jpeg";
import ekaterina from "../assets/images/teachers/teacher_ekaterina_kudryavtseva.jpg";
import alexandra from "../assets/images/teachers/teacher_aleksandra_novikova.png";
import valeria from "../assets/images/teachers/teacher_valeriia_lovetskaia_chess.jpeg";

const WA = `https://wa.me/6580745012?text=${encodeURIComponent(
  "Здравствуйте! Хочу узнать про преподавателей и занятия в KIT",
)}`;

const teachers = [
  {
    photo: olga,
    name: "Ольга Бельская",
    role: "Основатель KIT",
    bio: "Более 15 лет в образовании: в 2006 году открыла Монтессори-школу в Москве, а с 2017 года развивает KIT в Сингапуре. Её задача — помочь русскоязычным детям сохранить родной язык в англоязычной среде и уверенно чувствовать себя в двух культурах.",
  },
  {
    photo: iana,
    name: "Яна Бельская",
    role: "Логопед-дефектолог, нейролингвист",
    bio: "Более 21 года в образовании и 15 лет работы с детьми-билингвами. Магистр логопедии и дефектологии (РУДН), Монтессори-педагог, преподаватель РКИ; сертифицированный в Сингапуре специалист по работе с детьми с особыми потребностями. Коучинг при СДВГ и дислексии, авторская методика для детей спектра. Готовит к экзаменам IGCSE и IB по русскому языку.",
  },
  {
    photo: ekaterina,
    name: "Екатерина Кудрявцева",
    role: "Русский язык и литература · IB и IGCSE",
    online: true,
    bio: "Кандидат педагогических наук, филолог, специалист по русскому как родному, иностранному и второму родному языку для билингвов. С 2017 года преподаёт русский язык и литературу в системе IB, работая онлайн со школами в Сингапуре, Австралии, США, Европе и Азии. Экзаменатор ТРКИ, автор более 50 книг и 200 статей, эксперт по геймификации обучения.",
  },
  {
    photo: alexandra,
    name: "Александра Новикова",
    role: "Музыка и вокал",
    bio: "Педагог с высшим музыкальным образованием (Master’s degree) и 20-летним стажем. Занимается с учениками от 4 лет. Её ученики занимают призовые места на конкурсах и поступают в ведущие музыкально-театральные вузы Англии и Америки.",
  },
  {
    photo: valeria,
    name: "Валерия Ловецкая",
    role: "Тренер по шахматам",
    bio: "Капитан женской сборной по шахматам Singapore Polytechnic. Более 6 лет преподаёт шахматы детям от 4 до 16 лет. Участница 48 официальных турниров FIDE, 2-е место в полуфинале чемпионата Москвы.",
  },
];
---

<Layout
  altUrl="/en/teachers"
  title="Преподаватели — KIT, школа русского языка в Сингапуре"
  description="Команда KIT: логопед-дефектолог, преподаватели русского языка и литературы, музыки и шахмат. Подготовка к экзаменам IGCSE и IB, работа с билингвами и детьми с особыми потребностями."
>
  <section class="tch-hero">
    <div class="container">
      <span class="eyebrow">Преподаватели</span>
      <h1>Наша команда</h1>
      <p class="lead">
        Опытные педагоги, которые любят своё дело и детей. Мы работаем с
        билингвами, готовим к экзаменам IGCSE и IB и помогаем каждому ребёнку
        раскрыться — в комфортной, семейной атмосфере.
      </p>
      <div class="hero-cta">
        <a class="btn btn-wa" href={WA} target="_blank" rel="noopener" data-cta="whatsapp-teachers">
          Записаться на занятия
        </a>
      </div>
    </div>
  </section>

  <section class="tch-list">
    <div class="container">
      <div class="tch-grid">
        {teachers.map((t) => (
          <article class="tch-card">
            <div class="tch-photo-wrap">
              <Image src={t.photo} alt={t.name} width={640} class="tch-photo" />
              {t.online && <span class="tch-badge">Онлайн</span>}
            </div>
            <div class="tch-body">
              <h2>{t.name}</h2>
              <p class="tch-role">{t.role}</p>
              <p class="tch-bio">{t.bio}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="tch-exam">
    <div class="container">
      <div class="tch-exam-card">
        <div>
          <span class="eyebrow">Подготовка к экзаменам</span>
          <h2>Русский язык на IGCSE и IB</h2>
          <p>
            Готовим к экзаменам по русскому языку и литературе — очно с Яной и
            онлайн с Екатериной. Индивидуальные программы и измеримый результат в
            сжатые сроки.
          </p>
        </div>
        <div class="tch-exam-links">
          <a class="btn btn-ghost" href="/ib-russian">Русский на IB →</a>
          <a class="btn btn-ghost" href="/igcse-russian">Русский на IGCSE →</a>
          <a class="btn btn-wa" href={WA} target="_blank" rel="noopener" data-cta="whatsapp-teachers-exam">
            Записаться
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .tch-hero {
    padding: clamp(2.5rem, 6vw, 4rem) 0 clamp(1.5rem, 4vw, 2.5rem);
    background: linear-gradient(180deg, var(--brand-soft), var(--cream));
  }
  .tch-hero .lead { margin-top: 0.5rem; }
  .hero-cta { margin-top: 1.6rem; display: flex; flex-wrap: wrap; gap: 0.8rem; }

  .tch-list { padding-top: clamp(2rem, 5vw, 3rem); }
  .tch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .tch-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
  }
  .tch-photo-wrap { position: relative; aspect-ratio: 4 / 3; background: var(--brand-soft); }
  .tch-photo { width: 100%; height: 100%; object-fit: cover; }
  .tch-badge {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    background: var(--brand-dark);
    color: #fff;
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
  }
  .tch-body { padding: 1.4rem; }
  .tch-body h2 { font-size: 1.2rem; margin: 0 0 0.2rem; }
  .tch-role {
    color: var(--brand);
    font-weight: 800;
    font-size: 0.9rem;
    margin: 0 0 0.8rem;
  }
  .tch-bio { color: var(--muted); margin: 0; font-size: 0.98rem; }

  .tch-exam { padding-top: clamp(1.5rem, 4vw, 2.5rem); }
  .tch-exam-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: clamp(1.6rem, 4vw, 2.4rem);
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem;
    align-items: center;
  }
  .tch-exam-card h2 { margin: 0.3rem 0 0.6rem; }
  .tch-exam-card p { color: var(--muted); margin: 0; }
  .tch-exam-links { display: flex; flex-direction: column; gap: 0.7rem; align-items: stretch; }
  .tch-exam-links .btn { width: 100%; }

  @media (max-width: 760px) {
    .tch-exam-card { grid-template-columns: 1fr; }
  }
</style>
